/* Bagel UI window.
   Every selector is scoped under .beall so nothing here leaks into the phones,
   which only get the season ThemeStyleSheet (the game's real runtime styles). */

.beall {
    flex-grow: 1;
    background-color: rgb(26, 17, 13);
}

/* ------------------------------------------------------------------ Toolbar (editor theme) */

/* Wraps to more rows when the window is narrow, sized to them from code (FitToolbar). Hugs its 22 px strips: 6 px
   above and below them, then its 1 px border. Rows as tall as their controls: a row stretched to the toolbar's
   height would push them down. Both windows' toolbars alike: the brand, Reset, then on the right the field (Search,
   Zoom) and the season and language strips. */
.beall__toolbar {
    flex-wrap: wrap;
    align-content: flex-start;
    height: auto;
    min-height: 35px;
    row-gap: 4px;
    flex-shrink: 0;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 4px;
    border-bottom-color: rgb(14, 9, 7);
}

.beall__brand {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    padding-right: 6px;
}

.beall__brand-dot {
    width: 14px;
    height: 14px;
    margin-right: 7px;
    border-radius: 7px;
    border-width: 3px;
    border-color: rgb(245, 166, 35);
    background-color: rgb(59, 31, 20);
}

.beall__brand-name {
    -unity-font-definition: url("/Assets/UI/Runtime/B00_Themes/T0_Common/Fonts/Bangers.ttf");
    font-size: 17px;
    letter-spacing: 1px;
    color: rgb(255, 214, 120);
    padding: 0;
    margin: 0 6px 0 0;
}

.beall__brand-sub {
    font-size: 11px;
    color: rgb(196, 160, 132);
    padding: 0;
    margin: 0;
}

.beall__brand-version {
    font-size: 10px;
    color: rgb(40, 22, 14);
    background-color: rgb(255, 214, 120);
    border-radius: 6px;
    padding: 0 5px;
    margin: 0 0 0 6px;
}

/* The controls on the right (Search or Zoom, the strips): the rest of the row, or a row of their own when the
   window is too narrow, on the right either way. Never narrower than they are: they'd spill over the left ones. */
.beall__toolbar-end {
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

/* The strips (BagelOptionStrip): Reset, New Game, the cheats (coins, gems and tickets, all shops and recipes), season,
   language, Inspector. */
.beall__strip {
    margin: 0 6px 0 0;
}

/* Reset, right after the brand. */
.beall__strip--reset {
    margin-left: 4px;
}

.beall__zoom > .unity-base-field__label {
    min-width: 0;
    width: auto;
    padding-right: 6px;
    -unity-font-style: bold;
}

/* The coins, gems and tickets cheats, in the colors of what they give, its icon after the amount. */
.beall__cheat--coins > .bagel-strip__label {
    color: rgb(255, 210, 90);
}

.beall__cheat--gems > .bagel-strip__label {
    color: rgb(255, 128, 110);
}

.beall__cheat--tickets > .bagel-strip__label {
    color: rgb(255, 150, 170);
}

/* Where Bagel Features has its search. */
.beall__zoom {
    width: 190px;
    margin: 0 4px 0 0;
}

.beall__zoom-label {
    width: 38px;
    -unity-text-align: middle-right;
    padding: 0;
    margin: 0 8px 0 0;
    color: rgb(196, 160, 132);
}

/* ------------------------------------------------------------------ Stage */

.beall__body {
    flex-grow: 1;
    flex-direction: row;
}

.beall__stage {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: rgb(26, 17, 13);
    background-image: radial-gradient(ellipse at center, rgb(84, 52, 36), rgb(46, 29, 21) 45%, rgb(22, 14, 11));
}

.beall__scroll {
    flex-grow: 1;
}

/* The stage has no theme at all (the editor theme would leak into the phones), so the
   ScrollView gets just the structural rules it needs; its scrollers get the editor theme. */
.beall__scroll > .unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row;
    flex-grow: 1;
}

.beall__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    overflow: hidden;
}

.beall__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 0;
    align-self: flex-start;
    min-height: 100%;
    justify-content: center;
    padding: 16px 32px 16px 32px;
}

.beall__scroll .unity-scroll-view__horizontal-scroller,
.beall__scroll .unity-scroll-view__vertical-scroller {
    flex-shrink: 0;
}

.beall__phones {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    gap: 28px;                  /* USS has no :last-child, so space the phones with gap */
}

/* ------------------------------------------------------------------ Phone frame */

.beall-phone {
    flex-shrink: 0;
    align-items: center;
}

/* Laid-out size of the scaled device (set from code: device size × zoom). */
.beall-phone__slot {
    flex-shrink: 0;
    width: 307px;
    height: 648px;
}

.beall-phone__glow {
    position: absolute;
    left: -14%;
    right: -14%;
    top: 30%;
    bottom: -12%;
    background-image: radial-gradient(ellipse at center, rgba(255, 168, 76, 0.24), rgba(255, 168, 76, 0) 70%);
}

/* 390×844 screen + 10px bezel (2px rim + 8px glass edge); border-box sizing. */
.beall-phone__device {
    position: absolute;
    left: 0;
    top: 0;
    width: 410px;
    height: 864px;
    padding: 8px;
    border-width: 2px;
    border-radius: 46px;
    border-top-color: rgb(132, 106, 92);
    border-left-color: rgb(96, 76, 66);
    border-right-color: rgb(96, 76, 66);
    border-bottom-color: rgb(58, 44, 38);
    background-color: rgb(14, 10, 9);
    /* The phone's soft shadow: a box-shadow, which follows its rounded corners and scales with its zoom. It's
       geometry, not a filter, so every phone stays cheap to repaint. (It was a radial-gradient element behind the
       phone, an ellipse that missed the corners.) */
    box-shadow: 0 30px 60px 10px rgba(0, 0, 0, 0.65);
    transform-origin: left top;
    transition-property: border-color;
    transition-duration: 0.2s;
}

.beall-phone__device:hover {
    border-top-color: rgb(255, 200, 120);
    border-left-color: rgb(214, 150, 84);
    border-right-color: rgb(214, 150, 84);
    border-bottom-color: rgb(150, 96, 52);
}

.beall-phone__screen {
    /* Text as in the game (SDF): the Editor's bitmap glyphs blur when a phone is scaled. */
    -unity-editor-text-rendering-mode: sdf;
    /* Every screen live at once: fewer season particles each (a USS variable the game reads). */
    --be-particle-count: 10;
    flex-shrink: 0;
    width: 390px;
    height: 844px;
    border-radius: 38px;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
}

/* The README's screenshots (BagelScreenshots): every season particle, as in the game. */
.beall-phone__screen.beall-phone__screen--full {
    --be-particle-count: 18;
}

.beall-phone__notch {
    position: absolute;
    top: 19px;
    left: 50%;
    translate: -50% 0;
    width: 118px;
    height: 33px;
    border-radius: 17px;
    background-color: rgb(6, 4, 4);
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding-right: 12px;
}

.beall-phone__camera {
    width: 11px;
    height: 11px;
    border-radius: 6px;
    background-color: rgb(24, 30, 46);
    border-width: 2px;
    border-color: rgb(34, 40, 58);
}

.beall-phone__side-button {
    position: absolute;
    width: 4px;
    border-radius: 2px;
    background-color: rgb(78, 62, 54);
}

.beall-phone__side-button--action {
    left: -5px;
    top: 120px;
    height: 34px;
}

.beall-phone__side-button--volume-up {
    left: -5px;
    top: 180px;
    height: 62px;
}

.beall-phone__side-button--volume-down {
    left: -5px;
    top: 254px;
    height: 62px;
}

.beall-phone__side-button--power {
    right: -5px;
    top: 200px;
    height: 96px;
}

/* ------------------------------------------------------------------ Caption */

.beall-phone__caption {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    margin-top: 12px;
}

.beall-phone__caption > Label,
.beall__brand > Label {
    white-space: nowrap;
    flex-shrink: 0;
}

.beall-phone__index {
    -unity-font-definition: url("/Assets/UI/Runtime/B00_Themes/T0_Common/Fonts/Bangers.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(59, 31, 20);
    background-color: rgb(255, 196, 40);
    border-radius: 9px;
    min-width: 34px;
    -unity-text-align: middle-center;
    padding: 1px 7px 0 7px;
    margin: 0 9px 0 0;
}

/* A caption longer than its phone (at a small zoom) ends in an ellipsis rather than widening the column. */
.beall-phone__caption > .beall-phone__title {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.beall-phone__title {
    -unity-font-definition: url("/Assets/UI/Runtime/B00_Themes/T0_Common/Fonts/Poppins-Bold.ttf");
    font-size: 15px;
    color: rgb(255, 240, 222);
    padding: 0;
    margin: 0;
}

.beall-phone__dot {
    font-size: 15px;
    color: rgb(150, 110, 88);
    padding: 0;
    margin: 0 6px;
}

.beall-phone__jp {
    font-size: 14px;
    color: rgb(214, 176, 146);
    padding: 0;
    margin: 0;
}

/* The phone's screen in Bagel Features: a gold pill, like the guide windows' window links. */
.beall-phone__link {
    height: 26px;
    padding: 0 14px;
    margin: 8px 0 0 0;
    border-radius: 13px;
    border-width: 1px;
    font-size: 12px;
    -unity-font-definition: url("/Assets/UI/Runtime/B00_Themes/T0_Common/Fonts/Poppins-Bold.ttf");
    -unity-text-align: middle-center;
    color: rgb(255, 214, 120);
    background-color: rgba(255, 196, 40, 0.1);
    border-color: rgba(255, 196, 40, 0.45);
}

.beall-phone__link:hover {
    background-color: rgba(255, 196, 40, 0.26);
}

.beall-phone__link:active {
    background-color: rgba(255, 196, 40, 0.4);
}

/* ------------------------------------------------------------------ Inspector dock (editor theme) */

.beall__dock {
    width: 360px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: rgb(14, 9, 7);
    background-color: var(--unity-colors-window-background);
}

.beall__dock--hidden {
    display: none;
}

.beall__dock-header {
    flex-shrink: 0;
    padding: 12px 14px 12px 14px;
    background-image: linear-gradient(to bottom, rgb(92, 46, 30), rgb(59, 31, 20));
    border-bottom-width: 1px;
    border-bottom-color: rgb(14, 9, 7);
}

.beall__dock-eyebrow {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(255, 196, 40);
    padding: 0;
    margin: 0;
}

.beall__dock-title {
    -unity-font-definition: url("/Assets/UI/Runtime/B00_Themes/T0_Common/Fonts/Bangers.ttf");
    font-size: 22px;
    letter-spacing: 1px;
    color: rgb(255, 240, 222);
    padding: 0;
    margin: 2px 0 2px 0;
}

.beall__dock-hint {
    font-size: 11px;
    white-space: normal;
    color: rgb(222, 190, 164);
    padding: 0;
    margin: 0;
}

.beall__dock-scroll {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

.beall__dock-host {
    padding: 6px 2px 12px 0;
}
