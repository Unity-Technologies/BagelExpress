            <ui:VisualElement class="sampler__cell">
                <Bagel.PastryIcon kind="Dorayaki" class="sampler__pastry" />
                <ui:Label text="Dorayaki" class="sampler__caption" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="PastryIcon (160px)" class="sampler__title" />
        <ui:VisualElement name="pastries-big" class="sampler__row">
            <Bagel.PastryIcon kind="SesameBagel" class="sampler__pastry--big" />
            <Bagel.PastryIcon kind="PoppySeedBagel" class="sampler__pastry--big" />
            <Bagel.PastryIcon kind="EverythingBagel" class="sampler__pastry--big" />
            <Bagel.PastryIcon kind="MatchaBagel" class="sampler__pastry--big" />
            <Bagel.PastryIcon kind="SakuraMochiBagel" class="sampler__pastry--big" />
