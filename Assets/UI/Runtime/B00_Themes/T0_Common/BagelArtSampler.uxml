            <Bagel.PastryIcon kind="GoldenMapleTaiyaki" class="sampler__pastry--tiny" />
            <Bagel.PastryIcon kind="Dorayaki" class="sampler__pastry--tiny" />
        </ui:VisualElement>
        <ui:VisualElement name="pastries-variants" class="sampler__row">
            <Bagel.PastryIcon kind="SesameBagel" show-face="false" class="sampler__pastry" />
            <Bagel.PastryIcon kind="PoppySeedBagel" show-face="false" class="sampler__pastry" />
            <Bagel.PastryIcon kind="EverythingBagel" show-face="false" class="sampler__pastry" />
            <Bagel.PastryIcon kind="MatchaBagel" show-face="false" class="sampler__pastry" />
