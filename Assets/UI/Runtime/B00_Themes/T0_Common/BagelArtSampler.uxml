            <Bagel.PastryIcon kind="CurryPan" class="sampler__pastry--big" />
            <Bagel.PastryIcon kind="Taiyaki" class="sampler__pastry--big" />
            <Bagel.PastryIcon kind="GoldenMapleTaiyaki" class="sampler__pastry--big" />
            <Bagel.PastryIcon kind="Dorayaki" class="sampler__pastry--big" />
        </ui:VisualElement>
        <ui:Label text="Small (32px / 24px), no face, silhouette" class="sampler__title" />
        <ui:VisualElement name="pastries-small" class="sampler__row">
            <Bagel.PastryIcon kind="SesameBagel" class="sampler__pastry--small" />
            <Bagel.PastryIcon kind="PoppySeedBagel" class="sampler__pastry--small" />
            <Bagel.PastryIcon kind="EverythingBagel" class="sampler__pastry--small" />
