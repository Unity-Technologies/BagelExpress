            <Bagel.PastryIcon kind="Taiyaki" class="sampler__pastry--small" />
            <Bagel.PastryIcon kind="GoldenMapleTaiyaki" class="sampler__pastry--small" />
            <Bagel.PastryIcon kind="Dorayaki" class="sampler__pastry--small" />
            <Bagel.PastryIcon kind="SesameBagel" class="sampler__pastry--tiny" />
            <Bagel.PastryIcon kind="PoppySeedBagel" class="sampler__pastry--tiny" />
            <Bagel.PastryIcon kind="EverythingBagel" class="sampler__pastry--tiny" />
            <Bagel.PastryIcon kind="MatchaBagel" class="sampler__pastry--tiny" />
            <Bagel.PastryIcon kind="SakuraMochiBagel" class="sampler__pastry--tiny" />
            <Bagel.PastryIcon kind="Anpan" class="sampler__pastry--tiny" />
            <Bagel.PastryIcon kind="MelonPan" class="sampler__pastry--tiny" />
