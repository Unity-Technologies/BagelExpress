<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="BagelExpressCommonStyles.uss" />
    <Style src="BagelArtSampler.uss" />
    <ui:VisualElement name="sampler" class="sampler">
        <ui:Label text="PastryIcon (72px)" class="sampler__title" />
        <ui:VisualElement name="pastries" class="sampler__row">
            <ui:VisualElement class="sampler__cell">
                <Bagel.PastryIcon kind="SesameBagel" class="sampler__pastry" />
                <ui:Label text="SesameBagel" class="sampler__caption" />
            </ui:VisualElement>
            <ui:VisualElement class="sampler__cell">
                <Bagel.PastryIcon kind="PoppySeedBagel" class="sampler__pastry" />
