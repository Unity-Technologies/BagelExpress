/* Bagel Express — Snow season. Only variables: every gradient, filter and art color in the common styles reads them. */

:root {
    --be-primary: rgb(60, 150, 230);
    --be-primary-light: rgb(150, 210, 255);
    --be-primary-dark: rgb(20, 90, 170);
    --be-accent: rgb(255, 90, 90);
    --be-accent-light: rgb(255, 170, 170);
    --be-accent-dark: rgb(200, 40, 50);
    --be-paper: rgb(250, 252, 255);
    --be-skyline-far: rgb(200, 220, 240);
    --be-skyline-near: rgb(110, 140, 180);
    --be-window-light: rgb(255, 220, 140);
    --be-particle-kind: snow;
    --be-mascot-accessory: snow;
    --be-sound-tone: bell;
    --be-awning-a: rgb(60, 150, 230);
    --be-awning-b: rgb(250, 252, 255);
    --be-noren-color: rgb(40, 70, 120);
    --be-bag-color: rgb(220, 50, 60);
    --be-burst-color-a: rgba(220, 240, 255, 0.95);
    --be-burst-color-b: rgba(120, 190, 255, 0.5);
    --be-title-burst-edge: rgb(78, 148, 228);
    --be-lantern-glow: rgba(255, 190, 120, 0.8);
    --be-sky-top: rgb(150, 205, 245);
    --be-sky-mid: rgb(205, 230, 250);
    --be-sky-bottom: rgb(245, 250, 255);

    /* The glass, tinted for the season (icy blue); light enough for dark text. */
    --be-frost: rgba(226, 240, 255, 0.6);
    --be-frost-solid: rgba(226, 240, 255, 0.88);
}
