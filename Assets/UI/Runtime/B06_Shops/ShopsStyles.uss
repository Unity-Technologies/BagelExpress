/* Bagel Express — Shops page and shop cards. */

.be-shops {
    flex-grow: 1;
}

.be-shops__summary {
    gap: 2px;
    margin-bottom: 6px;
}

.be-shops__summary-text {
    padding: 0;
    margin: 0;
    color: var(--be-white);
}

.be-shops__list {
    flex-grow: 1;
}

/* The list virtualizes its content's top padding and height, and sets its items' top padding and margins inline,
   so the first and last cards hold the space that keeps them clear of the glass (see .be-scroll-well), in their
   margins: ShopsPaneManager marks their items. The cards sit 24 points from the screen's sides, as on the other
   scrolling pages; the scrollbar floats over the right margin (see .be-scroll-well). */
.be-shops__list .unity-scroll-view__content-container {
    padding: 0 24px;
}

.be-shops__list .unity-list-view__item {
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
}

.be-shops__list .be-shops__item--first .be-shop-card {
    margin-top: 300px;
}

.be-shops__list .be-shops__item--last .be-shop-card {
    margin-bottom: 198px;
}

/* ------------------------------------------------------------------ Card */

.be-shop-card {
    flex-direction: row;
    align-items: center;
    height: 112px;
    margin: 6px 0 10px 0;
    padding: 10px 10px 10px 10px;
    gap: 8px;
    border-width: var(--be-border);
    border-color: var(--be-ink);
    border-radius: var(--be-radius-l);
    background-color: var(--be-paper);
    background-image: linear-gradient(to bottom, var(--be-surface-top), var(--be-paper) 60%, var(--be-paper-shade));
    border-bottom-width: var(--be-tile-lip);
    overflow: visible;
}

.be-shop-card__emblem {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--be-border);
    border-color: var(--be-ink);
    border-radius: 50%;
    background-image: radial-gradient(circle at center, rgb(255, 250, 238), rgb(255, 216, 160) 70%, rgb(240, 170, 100));
    overflow: visible;
}

.be-shop-card--japan .be-shop-card__emblem {
    background-image: radial-gradient(circle at center, rgb(255, 248, 248), rgb(255, 200, 210) 70%, rgb(240, 130, 150));
}

.be-shop-card__pastry {
    width: 52px;
    height: 52px;
}

.be-shop-card__flag {
    position: absolute;
    right: -6px;
    bottom: -4px;
    width: 30px;
    height: 30px;
    background-image: url("/Assets/UI/Runtime/B02_Common/Icons/icon-montreal.svg");
}

.be-shop-card--japan .be-shop-card__flag {
    background-image: url("/Assets/UI/Runtime/B02_Common/Icons/icon-japan.svg");
}

.be-shop-card__lock {
    position: absolute;
    width: 34px;
    height: 34px;
    background-image: url("/Assets/UI/Runtime/B02_Common/Icons/icon-lock.svg");
    display: none;
}

.be-shop-card__info {
    flex-grow: 1;
    flex-shrink: 1;
    gap: 1px;
}

.be-shop-card__name {
    font-size: 14px;
    color: var(--be-text);
    white-space: normal;
    padding: 0;
    margin: 0;
}

.be-shop-card__jp {
    font-size: var(--be-font-xs);
    color: var(--be-text-muted);
    padding: 0;
    margin: 0 0 3px 0;
}

.be-shop-card__stats {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.be-shop-card__level {
    height: 20px;
    padding: 0 8px;
    margin: 0;
    -unity-text-align: middle-center;
    border-radius: 10px;
    border-width: var(--be-border-thin);
    border-color: var(--be-ink);
    background-image: linear-gradient(to bottom, var(--be-primary-light), var(--be-primary));
    color: var(--be-white);
    font-size: var(--be-font-s);
    text-shadow: 0 1px 0 var(--be-ink);
}

.be-shop-card__pips .be-pips__pip {
    width: 9px;
    height: 9px;
    margin: 1px;
}

.be-shop-card__income {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.be-shop-card__income-now,
.be-shop-card__arrow,
.be-shop-card__income-next {
    font-size: var(--be-font-s);
    padding: 0;
    margin: 0 2px 0 0;
}

.be-shop-card__income-now {
    color: var(--be-text-muted);
}

.be-shop-card__arrow {
    font-size: 8px;
    color: var(--be-text-positive);
}

.be-shop-card__income-next {
    color: var(--be-text-positive);
}

.be-shop-card__closed {
    display: none;
    font-size: var(--be-font-s);
    color: var(--be-text-muted);
    padding: 0;
    margin: 0;
}

/* Action button, in a column with the milestone sticker above it when the next upgrade is a milestone. */

.be-shop-card__action-column {
    flex-shrink: 0;
    width: 92px;
    align-items: center;
    justify-content: center;
    gap: 2px;
}

.be-shop-card__action {
    width: 92px;
    height: 70px;
    min-height: 0;
    flex-direction: column;
    padding: 2px 4px 8px 4px;
    gap: 0;
}

.be-shop-card__action-label {
    -unity-font-definition: url("/Assets/UI/Runtime/B00_Themes/T0_Common/Fonts/Bangers.ttf");
    font-size: 20px;
    letter-spacing: 1px;
}

.be-shop-card__action-label--unlock,
.be-shop-card__cost-text--unlock {
    display: none;
}

/* The coin is a circle 2 points in, concentric with the pill's round end (11 - 2 = 9). */
.be-shop-card__cost {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 7px 0 2px;
    border-radius: 11px;
    background-color: rgba(59, 31, 20, 0.35);
}

.be-shop-card__cost-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

/* Resting pose = can't afford yet (USS has no :not()); affordable is additive. */
.be-shop-card__cost-text {
    font-size: 11px;
    color: rgb(255, 190, 190);
    padding: 0 0 0 2px;
    margin: 0;
}

.be-shop-card--affordable .be-shop-card__cost-text {
    color: var(--be-white);
}

.be-shop-card__milestone {
    display: none;
    animation: url("/Assets/UI/Runtime/B02_Common/Animations/Pulse.asset") 0.9s infinite;
}

.be-shop-card--milestone-next .be-shop-card__milestone {
    display: flex;
}

/* With the sticker above it, the button gives up 10 points: 20 + 2 + 60 fill the card's 82. */
.be-shop-card--milestone-next .be-shop-card__action {
    height: 60px;
    padding-top: 0;
    padding-bottom: 4px;
    background-image: linear-gradient(to bottom, var(--be-gold-light), var(--be-gold) 50%, var(--be-gold-dark));
}

/* Locked: grayscale card with an OPEN button. */

.be-shop-card--locked {
    background-image: linear-gradient(to bottom, var(--be-surface-locked-top), var(--be-surface-locked-bottom));
}

/* Gray without a grayscale() filter: a gray emblem, a dimmed flag, a silhouette pastry. */
.be-shop-card--locked .be-shop-card__emblem {
    background-image: radial-gradient(circle at center, rgb(246, 244, 240), rgb(208, 202, 196) 70%, rgb(168, 160, 152));
}

.be-shop-card--locked .be-shop-card__flag {
    opacity: 0.45;
}

.be-shop-card--locked .be-shop-card__lock {
    display: flex;
}

.be-shop-card--locked .be-shop-card__stats,
.be-shop-card--locked .be-shop-card__income,
.be-shop-card--locked .be-shop-card__milestone,
.be-shop-card--locked .be-shop-card__action-label--upgrade,
.be-shop-card--locked .be-shop-card__cost-text--upgrade {
    display: none;
}

.be-shop-card--locked .be-shop-card__closed,
.be-shop-card--locked .be-shop-card__action-label--unlock,
.be-shop-card--locked .be-shop-card__cost-text--unlock {
    display: flex;
}

.be-shop-card--locked .be-shop-card__action {
    background-image: linear-gradient(to bottom, rgb(130, 210, 255), rgb(64, 168, 240) 55%, rgb(20, 104, 196));
}

.be-shop-card--upgraded {
    animation: url("/Assets/UI/Runtime/B02_Common/Animations/PillBump.asset");
}
