/* Bagel Express — Recipe Book (USS Grid), recipe cards, detail sheet. */

.be-recipes {
    flex-grow: 1;
}

.be-recipes__chips {
    align-items: flex-end;
    gap: 4px;
    margin-bottom: 4px;
}

.be-recipes__chip-text {
    padding: 0 2px 0 0;
    margin: 0;
    color: var(--be-white);
}

.be-recipes__bonus {
    background-color: rgba(20, 140, 84, 0.8);
}

.be-recipes__scroll {
    flex-grow: 1;
}

/* Clear of the glass at the top, 14 points inside the window (see .be-scroll-well), and at the bottom clear of the nav's
   Lucky Bag, which rises 28 points into the window. */
.be-recipes__scroll .unity-scroll-view__content-container {
    padding: 300px 24px 198px 24px;
}

/* Experimental Grid layout: 3 equal columns, the UR card spans 2x2. */
.be-recipes__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 132px;
    grid-auto-flow: row-dense;
    gap: 12px 10px;
}

.be-recipes__cell--featured {
    grid-column: span 2;
    grid-row: span 2;
}

/* ------------------------------------------------------------------ Card */

.be-recipe-card {
    flex-grow: 1;
    overflow: visible;
    transition-property: scale, translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.be-recipe-card:hover {
    scale: 1.04 1.04;
}

.be-recipe-card:active {
    translate: 0 3px;
}

/* Radii nest: frame 20, art 7 in (3 border + 4 padding) at 13, its tags 4 in (2 border + 2) at 9: pills 18 tall. */
.be-recipe-card__frame {
    flex-grow: 1;
    padding: 4px;
    border-width: var(--be-border);
    border-color: var(--be-ink);
    border-radius: 20px;
    background-image: linear-gradient(160deg, rgb(230, 224, 216), var(--be-rarity-n) 60%, rgb(140, 132, 124));
    border-bottom-width: var(--be-tile-lip);
}

.be-recipe-card--r .be-recipe-card__frame {
    background-image: linear-gradient(160deg, rgb(170, 214, 255), var(--be-rarity-r) 60%, rgb(30, 96, 180));
}

.be-recipe-card--sr .be-recipe-card__frame {
    background-image: linear-gradient(160deg, rgb(226, 196, 255), var(--be-rarity-sr) 60%, rgb(110, 50, 180));
}

.be-recipe-card--ssr .be-recipe-card__frame {
    background-image: linear-gradient(160deg, rgb(255, 246, 180), var(--be-rarity-ssr) 55%, rgb(210, 120, 0));
}

.be-recipe-card--ur .be-recipe-card__frame {
    background-image: linear-gradient(135deg, rgb(255, 150, 200), rgb(255, 230, 120) 35%, rgb(140, 230, 255) 70%, rgb(200, 150, 255));
}

/* The theme's shade over the rarity frame (USS gradients take no tint): clear in the light seasons, dark at night,
   so the rarity colors stay, dimmed. It fills the frame inside its border, under the picture and the labels. */
.be-recipe-card__shade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 17px 17px 13px 13px;
    background-color: var(--be-card-shade);
}

.be-recipe-card__art {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    border-width: var(--be-border-thin);
    border-color: var(--be-ink);
    border-radius: 13px;
    background-image: radial-gradient(circle at center, var(--be-card-art-center), var(--be-card-art-mid) 70%, var(--be-card-art-edge));
    overflow: hidden;
}

/* Under the tags' row (2 + 18 + 4), not under the tags. */
.be-recipe-card__pastry {
    width: 60%;
    height: 60%;
    max-width: 200px;
    max-height: 200px;
    margin-top: 18px;
}

.be-recipes__cell--featured .be-recipe-card__pastry {
    width: 78%;
    height: 78%;
    animation: url("/Assets/UI/Runtime/B02_Common/Animations/FloatBob.asset") 2.2s infinite;
}

.be-recipe-card__shine {
    position: absolute;
    top: -20%;
    bottom: -20%;
    left: 0;
    width: 40px;
    rotate: 18deg;
    background-image: linear-gradient(to right, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0));
    display: none;
}

.be-recipe-card--ssr .be-recipe-card__shine,
.be-recipe-card--ur .be-recipe-card__shine {
    display: flex;
    animation: url("/Assets/UI/Runtime/B02_Common/Animations/Shimmer.asset") 2.6s infinite;
}

.be-recipe-card__rarity {
    position: absolute;
    left: 2px;
    top: 2px;
    height: 18px;
    padding: 0 6px;
    margin: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/UI/Runtime/B00_Themes/T0_Common/Fonts/Bangers.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--be-white);
    border-radius: 9px;
    border-width: var(--be-border-thin);
    border-color: var(--be-ink);
    background-color: var(--be-rarity-n);
    text-shadow: 0 1px 0 var(--be-ink);
}

.be-recipe-card--r .be-recipe-card__rarity { background-color: var(--be-rarity-r); }
.be-recipe-card--sr .be-recipe-card__rarity { background-color: var(--be-rarity-sr); }
.be-recipe-card--ssr .be-recipe-card__rarity { background-color: var(--be-rarity-ssr); }
.be-recipe-card--ur .be-recipe-card__rarity { background-image: linear-gradient(to right, rgb(255, 120, 180), rgb(255, 210, 90), rgb(120, 210, 255)); }

.be-recipe-card__name {
    -unity-text-align: middle-center;
    font-size: var(--be-font-xs);
    white-space: normal;
    color: var(--be-white);
    text-shadow: 0 1px 0 var(--be-ink);
    padding: 3px 0 0 0;
    margin: 0;
}

.be-recipes__cell--featured .be-recipe-card__name {
    font-size: var(--be-font-m);
}

.be-recipe-card__unknown {
    display: none;
    -unity-text-align: middle-center;
    font-size: var(--be-font-s);
    color: var(--be-white);
    padding: 3px 0 0 0;
    margin: 0;
}

/* Locked: gray frame, art and badge (no grayscale() filter, so no offscreen pass per card). */
.be-recipe-card--locked .be-recipe-card__frame {
    background-image: linear-gradient(160deg, rgb(214, 210, 204), rgb(170, 164, 158) 60%, rgb(128, 122, 116));
}

/* Muted rarity tints, so the rarity still reads before the card is unlocked. */
.be-recipe-card--locked.be-recipe-card--r .be-recipe-card__frame {
    background-image: linear-gradient(160deg, rgb(206, 212, 222), rgb(146, 158, 176) 60%, rgb(104, 114, 132));
}

.be-recipe-card--locked.be-recipe-card--sr .be-recipe-card__frame {
    background-image: linear-gradient(160deg, rgb(214, 206, 224), rgb(156, 142, 176) 60%, rgb(112, 100, 134));
}

.be-recipe-card--locked.be-recipe-card--ssr .be-recipe-card__frame {
    background-image: linear-gradient(160deg, rgb(226, 220, 198), rgb(184, 170, 136) 55%, rgb(140, 126, 96));
}

.be-recipe-card--locked.be-recipe-card--ur .be-recipe-card__frame {
    background-image: linear-gradient(135deg, rgb(214, 190, 202), rgb(214, 206, 174) 35%, rgb(178, 204, 214) 70%, rgb(194, 182, 214));
}

.be-recipe-card--locked .be-recipe-card__art {
    background-image: radial-gradient(circle at center, var(--be-card-art-locked-center), var(--be-card-art-locked-mid) 70%, var(--be-card-art-locked-edge));
}

.be-recipe-card--locked .be-recipe-card__rarity {
    background-color: rgb(150, 144, 138);
    background-image: none;
}

.be-recipe-card--locked .be-recipe-card__name {
    display: none;
}

.be-recipe-card--locked .be-recipe-card__unknown {
    display: flex;
}

.be-recipe-card--locked .be-recipe-card__shine {
    display: none;
}

/* In the art's top-right corner, opposite the rarity and like it 4 points in (3 + 4 + 2 + 2 = 11 from the card). */
.be-recipe-card__new {
    display: none;
    position: absolute;
    right: 11px;
    top: 11px;
    height: 18px;
    padding: 0 6px;
    border-radius: 9px;
    font-size: 9px;
}

.be-recipe-card--new .be-recipe-card__new {
    display: flex;
    animation: url("/Assets/UI/Runtime/B02_Common/Animations/Pulse.asset") 0.8s infinite;
}

/* ------------------------------------------------------------------ Detail sheet
   Hidden via an additive class so the resting pose stays authorable. */

.be-recipes__scrim {
    background-color: rgba(59, 31, 20, 0.45);
    backdrop-filter: blur(6px);
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.be-recipes__sheet {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 100px;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 14px;
    /* Closed: all the way below the screen (its own height and the 100 points under it). */
    translate: 0 200%;
    transition-property: translate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.be-recipes--sheet-open .be-recipes__scrim {
    display: flex;
    opacity: 1;
}

.be-recipes--sheet-open .be-recipes__sheet {
    translate: 0 0;
}

/* The pastry on a starburst medallion, clipped to its circle so the starburst stays inside the sheet. */
.be-recipes__sheet-art {
    width: 120px;
    height: 120px;
    align-items: center;
    justify-content: center;
    border-radius: 60px;
    overflow: hidden;
}

.be-recipes__sheet-burst {
    --be-burst-color-a: var(--be-prize-burst-a);
    --be-burst-color-b: var(--be-prize-burst-b);
    --be-burst-center: var(--be-prize-burst-center);
    position: absolute;
    left: -30px;
    top: -30px;
    right: -30px;
    bottom: -30px;
    animation: url("/Assets/UI/Runtime/B02_Common/Animations/SpinSlow.asset") 10s infinite;
}

.be-recipes__sheet-pastry {
    width: 92px;
    height: 92px;
}

.be-recipes__sheet-info {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 150px;
}

.be-recipes__sheet-rarity {
    align-self: flex-start;
    height: 20px;
    padding: 0 8px;
    margin: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/UI/Runtime/B00_Themes/T0_Common/Fonts/Bangers.ttf");
    font-size: 16px;
    color: var(--be-white);
    border-radius: 10px;
    background-color: var(--be-primary);
    text-shadow: 0 1px 0 var(--be-ink);
}

.be-recipes__sheet-name {
    font-size: var(--be-font-l);
    white-space: normal;
    color: var(--be-text);
    padding: 0;
    margin: 2px 0 0 0;
}

.be-recipes__sheet-jp {
    font-size: var(--be-font-s);
    color: var(--be-text-muted);
    padding: 0;
    margin: 0;
}

.be-recipes__sheet-description {
    font-size: var(--be-font-s);
    white-space: normal;
    color: var(--be-text-soft);
    padding: 0;
    margin: 6px 0 0 0;
}

/* Across the sheet's bottom corners: a pill (34 tall), about concentric with the sheet's corners (28 - 15 = 13). */
.be-recipes__sheet-close {
    flex-basis: 100%;
    height: 34px;
    border-radius: 17px;
}
