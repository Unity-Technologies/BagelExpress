        m_KeyId: 896277910590963799
        m_Metadata:
          m_Items: []
        m_Value: Boulangerie matcha de Kyoto
    - rid: 854321853544792234
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963800
        m_Metadata:
          m_Items: []
        m_Value: "Bagel au s\xE9same"
    - rid: 854321853544792235
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963801
        m_Metadata:
          m_Items: []
        m_Value: "Roul\xE9 \xE0 la main, bouilli dans l'eau au miel, cuit au feu de bois. Le classique de Montr\xE9al."
    - rid: 854321853544792236
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963802
        m_Metadata:
          m_Items: []
        m_Value: Bagel au pavot
    - rid: 854321853544792237
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963803
        m_Metadata:
          m_Items: []
        m_Value: "Dense, sucr\xE9 et couvert de minuscules graines de pavot."
    - rid: 854321853544792238
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963804
        m_Metadata:
          m_Items: []
        m_Value: Anpan
    - rid: 854321853544792239
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963805
        m_Metadata:
          m_Items: []
        m_Value: "Petit pain moelleux fourr\xE9 \xE0 la p\xE2te de haricots rouges."
    - rid: 854321853544792240
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963806
        m_Metadata:
          m_Items: []
        m_Value: Melon pan
    - rid: 854321853544792241
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963807
        m_Metadata:
          m_Items: []
        m_Value: "Cro\xFBte de biscuit croquante sur une mie moelleuse. Pas de melon dedans\_!"
    - rid: 854321853544792242
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963808
        m_Metadata:
          m_Items: []
        m_Value: Bagel tout garni
    - rid: 854321853544792243
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963809
        m_Metadata:
          m_Items: []
        m_Value: "S\xE9same, pavot, ail, oignon et sel. Pourquoi choisir\_?"
    - rid: 854321853544792244
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963810
        m_Metadata:
          m_Items: []
        m_Value: Curry pan
    - rid: 854321853544792245
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963811
        m_Metadata:
          m_Items: []
        m_Value: "Frit, pan\xE9 et fourr\xE9 au curry japonais."
    - rid: 854321853544792246
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963812
        m_Metadata:
          m_Items: []
        m_Value: Taiyaki
    - rid: 854321853544792247
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963813
        m_Metadata:
          m_Items: []
        m_Value: "Petit g\xE2teau en forme de poisson, au c\u0153ur de haricots rouges."
    - rid: 854321853544792248
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963814
        m_Metadata:
          m_Items: []
        m_Value: Dorayaki
    - rid: 854321853544792249
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963815
        m_Metadata:
          m_Items: []
        m_Value: "Deux cr\xEApes moelleuses qui serrent un anko bien sucr\xE9."
    - rid: 854321853544792250
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963816
        m_Metadata:
          m_Items: []
        m_Value: Bagel au matcha
    - rid: 854321853544792251
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963817
        m_Metadata:
          m_Items: []
        m_Value: "Du matcha de Kyoto p\xE9tri dans une p\xE2te de Montr\xE9al."
    - rid: 854321853544792252
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963818
        m_Metadata:
          m_Items: []
        m_Value: "Melon pan \xE0 l'\xE9rable"
    - rid: 854321853544792253
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963819
        m_Metadata:
          m_Items: []
        m_Value: "Sirop d'\xE9rable du Qu\xE9bec glac\xE9 sur une cro\xFBte de melon pan craquante."
    - rid: 854321853544792254
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963820
        m_Metadata:
          m_Items: []
        m_Value: Bagel sakura mochi
    - rid: 854321853544792255
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 896277910590963821
        m_Metadata:
          m_Items: []
        m_Value: "Bagel mochi moelleux, fleur de cerisier et cr\xE8me de haricots blancs."
